{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalcBJ",
  "version": "0.1.1",
  "identifier": "com.calcbj.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "CalcBJ",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "shortDescription": "Blackjack advantage calculator",
    "longDescription": "Simulate a blackjack game with your count, indices and bet ramp, and get win rate, SCORE, N0, risk of ruin and bankroll requirements.",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
